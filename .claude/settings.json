{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "claude-fable-5-2",
  "effortLevel": "medium",
  "permissions": {
    "deny": [
      "Read(./archive/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write|NotebookEdit|Grep|Glob|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-archive.mjs\"",
            "timeout": 10,
            "statusMessage": "Checking archive guard"
          }
        ]
      }
    ]
  }
}
